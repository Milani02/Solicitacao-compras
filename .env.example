# Supabase — copie os valores em Settings > API e Settings > Database do seu projeto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — connection string do Postgres (Session Pooler ou Direct connection)
DATABASE_URL=

# SMTP para envio de e-mails de notificação
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Solicitação de Compras <compras@suaempresa.com.br>"
# Enquanto estiver preenchido, TODOS os e-mails do sistema são redirecionados
# para esses endereços de teste em vez do destinatário real.
EMAIL_TESTE_PARA=

# URL pública da aplicação (usada nos links dos e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Webhook do n8n — disparado quando uma solicitação nova é criada, pra
# avisar a Diretoria no Discord (ou outro canal configurado no fluxo)
N8N_WEBHOOK_SOLICITACAO_URL=
